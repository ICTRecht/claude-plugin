# ── ContextForge MCP Gateway — gehardende omgevingsvariabelen ───────────────
# Kopieer naar .env en vul ALLE secrets in. Commit .env NOOIT (zie .gitignore).
# Pin de image-tag op de actueel laatste *stable* release.
MCPGATEWAY_IMAGE=ghcr.io/ibm/mcp-context-forge:1.0.0-RC-3

# ── Secrets (genereer met: openssl rand -hex 32) ────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
AUTH_ENCRYPTION_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Bootstrap-admin (alleen voor eerste login; daarna OIDC gebruiken) ───────
PLATFORM_ADMIN_EMAIL=admin@example.org
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_sterk_wachtwoord
BASIC_AUTH_USER=CHANGE_ME_niet_admin
BASIC_AUTH_PASSWORD=CHANGE_ME_sterk_wachtwoord

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true

# ── Authenticatie / tokens (hardening) ──────────────────────────────────────
REQUIRE_JTI=true                 # JTI verplicht -> token-revocatie mogelijk
REQUIRE_TOKEN_EXPIRATION=true    # geen tokens zonder exp
SECURE_COOKIES=true              # cookies alleen over HTTPS (proxy termineert TLS)
# ── SSO / OAuth — TWEE providers tegelijk; klant kiest bij het inloggen ──────
# Setup-stappen (realm/app-registratie): zie OAUTH-SETUP.md
SSO_ENABLED=true
SSO_PRESERVE_ADMIN_AUTH=true        # lokale admin-login blijft als noodingang
SSO_AUTO_CREATE_USERS=true
SSO_TRUSTED_DOMAINS=["jouwbedrijf.nl"]

# Publieke hostnames (voor TLS-proxy + OAuth callback-URL's)
GATEWAY_PUBLIC_URL=https://mcp.jouwbedrijf.nl
IDP_PUBLIC_URL=https://idp.jouwbedrijf.nl

# Waar de stack gateway(4444)/keycloak(8080) publiceert voor je EIGEN nginx (edge).
# Eigen nginx op dezelfde host? laat 127.0.0.1 staan.
# Eigen nginx op een andere host/VM? zet het LAN-IP van deze VM (bv. 192.168.1.50)
# en sta die poorten in de firewall alleen toe vanaf de nginx-host.
PUBLISH_BIND=127.0.0.1

# (1) Keycloak — self-hosted (in deze stack meegeleverd)
SSO_KEYCLOAK_ENABLED=true
SSO_KEYCLOAK_BASE_URL=https://idp.jouwbedrijf.nl
SSO_KEYCLOAK_REALM=mcp
SSO_KEYCLOAK_CLIENT_ID=mcp-gateway
SSO_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_keycloak_client_secret
# Callback: ${GATEWAY_PUBLIC_URL}/auth/sso/callback/keycloak

# (2) Microsoft Entra ID
SSO_ENTRA_ENABLED=true
SSO_ENTRA_CLIENT_ID=CHANGE_ME_entra_app_client_id
SSO_ENTRA_CLIENT_SECRET=CHANGE_ME_entra_client_secret
SSO_ENTRA_TENANT_ID=CHANGE_ME_entra_tenant_id
# Callback: ${GATEWAY_PUBLIC_URL}/auth/sso/callback/entra

# ── Keycloak-container (self-hosted IdP) ────────────────────────────────────
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_sterk_wachtwoord
KC_DB_PASSWORD=CHANGE_ME_sterk_wachtwoord

# ── Servicetoken: gateway -> eigen MCP-server (intern netwerk) ───────────────
# Genereer met manage_tokens.py (zie OAUTH-SETUP.md) en plak hier:
MCP_BACKEND_TOKEN=CHANGE_ME_service_token_van_manage_tokens

# ── SSRF / content-limieten (testplan INJ-04, DOS-04) ───────────────────────
SSRF_ALLOW_PRIVATE_NETWORKS=false   # blokkeer RFC1918/localhost/metadata
UAID_ALLOWED_DOMAINS=                # cross-gateway domein-allowlist (leeg = blokkeer)
CONTENT_MAX_RESOURCE_SIZE=102400     # 100 KB
CONTENT_MAX_PROMPT_SIZE=10240        # 10 KB

# ── Database (state / RBAC) ─────────────────────────────────────────────────
POSTGRES_USER=mcpgw
POSTGRES_PASSWORD=CHANGE_ME_sterk_wachtwoord
POSTGRES_DB=mcpgateway
DATABASE_URL=postgresql://mcpgw:CHANGE_ME_sterk_wachtwoord@postgres:5432/mcpgateway

# ── Redis (sessies / cache) ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ════════════════════════════════════════════════════════════════════════════
# SIMPELE PAD — eigen token-MCP-server (docker-compose.simple.yml)
# De OpenWebUI-API-key blijft HIER server-side en gaat nooit naar clients.
# ════════════════════════════════════════════════════════════════════════════
OPENWEBUI_BASE_URL=https://openwebui.example.org
OPENWEBUI_API_KEY=CHANGE_ME_openwebui_api_key
OPENWEBUI_KNOWLEDGE_ID=CHANGE_ME_knowledge_collection_id
OPENWEBUI_MODEL=CHANGE_ME_model_naam
UPSTREAM_TIMEOUT=30
TOKEN_DB_PATH=/data/tokens.db
