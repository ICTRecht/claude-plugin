# ─────────────────────────────────────────────────────────────────────────────
# Voor JOUW bestaande nginx (de edge/reverse proxy elders op Proxmox).
# Twee vhosts: mcp.* -> ContextForge-gateway, idp.* -> Keycloak.
# TLS termineert HIER (Let's Encrypt); naar de stack ga je over HTTP.
#
# Vervang:
#   - jouwbedrijf.nl    -> je eigen domein
#   - STACK_IP          -> IP van de Proxmox-VM met de stack (of 127.0.0.1 als nginx
#                          op dezelfde host draait). Moet matchen met PUBLISH_BIND in .env.
# ─────────────────────────────────────────────────────────────────────────────

# Streaming/SSE-vriendelijke upgrade-map (zet 1x in http{}-context als je die nog niet hebt):
# map $http_upgrade $connection_upgrade { default upgrade; '' ''; }

# ── MCP-gateway ──────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name mcp.jouwbedrijf.nl;

    # Let's Encrypt (pas paden aan op jouw certbot-setup):
    ssl_certificate     /etc/letsencrypt/live/mcp.jouwbedrijf.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.jouwbedrijf.nl/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    client_max_body_size 1m;

    location / {
        proxy_pass http://STACK_IP:4444;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;     # belangrijk: gateway weet dat het HTTPS is

        # Streamable HTTP / SSE (MCP):
        proxy_http_version 1.1;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}

# ── Keycloak (klant-login) ───────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name idp.jouwbedrijf.nl;

    ssl_certificate     /etc/letsencrypt/live/idp.jouwbedrijf.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/idp.jouwbedrijf.nl/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    location / {
        proxy_pass http://STACK_IP:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;     # Keycloak draait met KC_PROXY_HEADERS=xforwarded
        proxy_set_header X-Forwarded-Host $host;
    }
}

# HTTP -> HTTPS (als je dat niet al centraal regelt):
server {
    listen 80;
    server_name mcp.jouwbedrijf.nl idp.jouwbedrijf.nl;
    return 301 https://$host$request_uri;
}
